{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.18.0/schemas/schema.json",
  "services": [
    {
      "product": "IP-Return-Service",
      "component": "IPV Return Front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/pre-commit.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/checks.yml",
          "path": "$.jobs.run-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pull-request-sonar.yml",
          "path": "$.jobs.run-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/dependabot.yml"
        }
      ]
    }
  ]
}
